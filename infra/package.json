{
  "name": "nuxthub-cloudflare-infra",
  "main": "index.ts",
  "scripts": {
    "preview": "node --env-file=.env --eval \"require('child_process').spawnSync('pulumi', ['preview'], { stdio: 'inherit' })\"",
    "apply": "node --env-file=.env --eval \"require('child_process').spawnSync('pulumi', ['up'], { stdio: 'inherit' })\"",
    "destroy": "node --env-file=.env --eval \"require('child_process').spawnSync('pulumi', ['destroy'], { stdio: 'inherit' })\""
  },
  "dependencies": {
    "@pulumi/cloudflare": "^5.49.1",
    "@pulumi/pulumi": "^3.257.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "~5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "protobufjs"
    ]
  }
}
