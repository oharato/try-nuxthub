# Cloudflare Credentials for Pulumi IaC
#
# Account ID: Cloudflare ダッシュボード右サイドバーに表示される 32 桁の英数字
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
#
# API Token: 「My Profile」>「API Tokens」>「Create Custom Token」より作成
# 必要な権限 (Account Permissions):
#   - D1: Edit
#   - Workers KV Storage: Edit
#   - Workers R2 Storage: Edit
#   - Cloudflare Pages: Edit
#   - Account Settings: Read (推奨)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
