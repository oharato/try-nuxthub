{
  "name": "try-nuxthub",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host 0.0.0.0",
    "generate": "nuxt generate",
    "preview": "npx nuxthub preview",
    "deploy:cf": "NITRO_PRESET=cloudflare_pages nuxt build && node --env-file=infra/.env ./node_modules/wrangler/bin/wrangler.js pages deploy dist",
    "infra:preview": "pnpm --dir infra preview",
    "infra:apply": "pnpm --dir infra apply",
    "infra:destroy": "pnpm --dir infra destroy",
    "db:migrate:prod": "node --env-file=infra/.env ./node_modules/wrangler/bin/wrangler.js d1 execute nuxthub-cloudflare-infra-prod-d1 --remote --file=server/db/migrations/sqlite/0000_nosy_arachne.sql",
    "db:generate": "drizzle-kit generate --config .nuxt/hub/db/drizzle.config.ts",
    "postinstall": "nuxt prepare",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "oxfmt --check . && oxlint . && nuxt typecheck && vitest run && nuxt build",
    "check:fix": "oxfmt --write . && oxlint --fix . && nuxt typecheck && vitest run && nuxt build"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "@nuxthub/core": "^0.10.8",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.2",
    "nuxt": "4.3.0",
    "nuxt-auth-utils": "^0.5.30",
    "unstorage": "^1.17.5"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.1.0",
    "happy-dom": "^20.11.2",
    "nuxthub": "^0.9.4",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.2.4",
    "wrangler": "^4.124.0"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "workerd",
      "protobufjs"
    ]
  }
}
