{
  "name": "try-nuxthub",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host 0.0.0.0",
    "generate": "nuxt generate",
    "preview": "npx nuxthub preview",
    "deploy:cf": "nuxt build && node --env-file=infra/.env ./node_modules/wrangler/bin/wrangler.js pages deploy dist",
    "infra:preview": "pnpm --dir infra preview",
    "infra:apply": "pnpm --dir infra apply",
    "infra:destroy": "pnpm --dir infra destroy",
    "db:migrate:prod": "node --env-file=infra/.env ./node_modules/wrangler/bin/wrangler.js d1 execute nuxthub-cloudflare-infra-prod-d1 --remote --file=server/database/migrations/0000_create_todos_table.sql",
    "db:migrations": "nuxthub database migrations list",
    "db:create": "nuxthub database migrations create",
    "postinstall": "nuxt prepare",
    "lint": "eslint ."
  },
  "dependencies": {
    "@nuxt/eslint": "^1.4.1",
    "@nuxthub/core": "^0.9.0",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^3.17.5",
    "vue": "^3.5.16",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.4.1",
    "eslint": "^9.29.0",
    "nuxthub": "^0.9.4",
    "typescript": "^5.8.3",
    "vue-tsc": "^2.2.10",
    "wrangler": "^4.124.0"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "workerd",
      "protobufjs"
    ]
  }
}
